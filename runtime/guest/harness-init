#!/bin/busybox sh
bb=/bin/busybox
export PATH=/root/.local/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu
export HOME=/root SHELL=/bin/bash TERM=xterm-256color LANG=C.UTF-8 PAGER=less
export NPM_CONFIG_PREFIX=/root/.local COREPACK_HOME=/root/.cache/corepack
rescue() {
    echo "HARNESS_BOOT_ERROR:$1"
    while :; do $bb setsid $bb cttyhack $bb sh -i; $bb sleep 1; done
}
$bb mount -t tmpfs -o mode=1777,size=128m tmpfs /tmp || rescue SYSTEM_MOUNT
$bb mount -t tmpfs -o mode=755,size=32m tmpfs /run || rescue SYSTEM_MOUNT
$bb mount -t tmpfs -o mode=755,size=32m tmpfs /var || rescue SYSTEM_MOUNT
$bb mkdir -p /dev/pts /run/lock /var/tmp
$bb mount -t devpts -o mode=620 devpts /dev/pts || rescue SYSTEM_MOUNT
$bb hostname harness-ipad
echo HARNESS_SYSTEM_READY
# debugfs defaults to read-only and reads the layout before journal repair.
# A newer or unreadable layout is preserved for rescue, without fsck writes.
layout=$(/usr/sbin/debugfs -R 'cat /.harness-layout-version' /dev/vdb 2>/dev/null)
if [ "$layout" != 1 ]; then rescue USER_LAYOUT; fi
# fsck runs only while unmounted and after the layout was accepted.
# 0=clean, 1=repaired.
/usr/sbin/e2fsck -p /dev/vdb
result=$?
[ "$result" -le 1 ] || rescue USER_FSCK
$bb mount -t ext4 -o errors=remount-ro /dev/vdb /root || rescue USER_MOUNT
# The host only appends a sparse tail; online growth is optional and never blocks boot.
/usr/sbin/resize2fs /dev/vdb >/dev/null 2>&1 || echo HARNESS_USER_RESIZE_SKIPPED
probe=/root/.write-check-$$
available=$($bb stat -f -c %a /root) || rescue USER_SPACE
[ "$available" -ge 1024 ] || rescue USER_SPACE
# A nonempty, synchronized write also checks actual block allocation and I/O.
(umask 077; $bb dd if=/dev/zero of="$probe" bs=4096 count=1 conv=fsync >/dev/null 2>&1) || rescue USER_SPACE
$bb rm "$probe"
$bb mkdir -p /root/projects /root/Documents /root/.dsh /root/.cache/node-compile-cache /root/.local/bin /root/.cache/corepack || rescue USER_READONLY
# Refresh our guidance unless the user removed the managed marker.
guide=/root/.dsh/AGENTS.md
if [ ! -e "$guide" ] || $bb grep -q '^<!-- harness-ipad managed' "$guide"; then
    $bb cp /opt/harness/AGENTS.md "$guide.tmp" && $bb mv "$guide.tmp" "$guide"
fi
echo HARNESS_USER_READY
$bb ifconfig lo 127.0.0.1 up
$bb udhcpc -q -n -t 5 -T 1 -i eth0 -s /etc/udhcpc/default.script || rescue NETWORK
$bb cat /etc/harness-runtime.json
export NODE_COMPILE_CACHE=/root/.cache/node-compile-cache
export NODE_OPTIONS="--require /opt/harness/compile-cache-flush.cjs"
cd /opt/harness || rescue SYSTEM_MOUNT
node backup.cjs --cold-boot || rescue USER_RESTORE
node clean-locks.cjs --cold-boot || rescue USER_LOCKS
# Seed once, including across deliberate project deletion and later upgrades.
if [ ! -e /root/.harness-example-seeded ]; then
    if [ ! -e /root/projects/ipad-hello-plugin ]; then
        $bb cp -R /opt/harness/examples/hello /root/projects/.hello-seed-$$ &&
        $bb mv /root/projects/.hello-seed-$$ /root/projects/ipad-hello-plugin || rescue USER_READONLY
    fi
    echo 1 > /root/.harness-example-seeded || rescue USER_READONLY
    $bb sync
fi
echo HARNESS_INIT_READY
# Control/transfer services stay responsive while /root is frozen. Only the
# official Harness child uses the persistent compiler cache and flush timers.
NODE_OPTIONS= NODE_COMPILE_CACHE= node transfer.cjs &
echo $! > /run/harness-transfer.pid
NODE_OPTIONS= NODE_COMPILE_CACHE= node preview.cjs &
echo $! > /run/harness-preview.pid
NODE_OPTIONS= NODE_COMPILE_CACHE= node harness-start.cjs &
# Serial shell is a recovery channel, separate from the official browser session.
while :; do $bb setsid $bb cttyhack $bb sh -i; $bb sleep 1; done
